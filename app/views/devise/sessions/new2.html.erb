<div class="bg-[#F8F7F6]">
  <div class="min-h-screen flex flex-col items-center justify-center p-6">
    <div class="grid lg:grid-cols-2 items-center gap-6 max-w-7xl max-lg:max-w-xl w-full">
      <!-- Image section -->
      <div class="h-full max-lg:mt-12 rounded-lg p-8">
        <img src="<%= image_path('sign_image.jpg') %>" class="w-full h-full object-cover" alt="Dining Experience" />
      </div>

      <!-- Form section -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="lg:max-w-md w-full mx-auto">
          <h3 class="text-gray-800 text-3xl font-extrabold mb-1">Sign In</h3>
          <p class="text-gray-400 text-sm pb-6">Enter your email address and password to access the admin panel.</p>
          <div class="space-y-6">
            <!-- Email input -->
            <div>
              <%= f.label :email, class: "block text-sm text-gray-600" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter your email", class: "w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-none" %>
            </div>

            <!-- Password input -->
            <div>
              <%= f.label :password, class: "block text-sm text-gray-600" %>
              <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password", class: "w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-none" %>
            </div>

            <!-- Remember me checkbox -->
            <% if devise_mapping.rememberable? %>
              <div class="flex items-center gap-x-2">
                <%= f.check_box :remember_me, class: "h-4 w-4 border-gray-300 checked:text-primary focus:ring-0" %>
                <%= f.label :remember_me, class: "ml-3 block text-sm text-gray-400" %>
              </div>
            <% end %>

            <!-- Reset password link -->
            <div class="flex items-center justify-between">
              <a href="/users/reset-password" class="text-sm text-gray-400">Reset password</a>
            </div>
          </div>

          <!-- Submit button -->
          <div class="my-4">
            <%= f.submit "Sign In", class: "w-full text-white bg-primary font-medium rounded-lg px-5 py-2.5 hover:bg-primary hover:transition hover:duration-700" %>
          </div>

          <!-- OR Sign in with -->
          <div class="flex items-center my-4">
            <hr class="flex-grow border-t border-gray-300" />
            <span class="mx-4 text-sm text-gray-400">OR sign in with</span>
            <hr class="flex-grow border-t border-gray-300" />
          </div>

          <!-- Social sign in buttons -->
          <div class="my-4">
            <button type="button" class="w-full bg-[#EEF2F6] text-gray-600 font-medium rounded-lg text-sm px-5 py-2.5 hover:bg-gray-500 hover:text-white">
              <div class="flex items-center justify-center gap-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <span>Sign in with Google</span>
              </div>
            </button>

            <button type="button" class="w-full bg-[#3b5998] my-3 text-white font-medium rounded-lg text-sm px-5 py-2.5 hover:bg-blue-600">
              <div class="flex items-center justify-center gap-x-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>                
                <span>Sign in with Facebook</span>
              </div>
            </button>
          </div>

          <!-- Sign up link -->
          <p class="text-sm text-red-500 mt-6 text-center">Don't have an account? 
            <%= link_to 'Sign Up',  new_user_registration_path, class: 'text-primary font-semibold hover:underline ml-1' %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
