<!DOCTYPE html>
<html>
<head>
  <title>Admin Panel</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag 'admin', media: 'all' %>
  <%= javascript_include_tag 'admin' %>
  <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %> 
</head>
<body class="h-screen flex flex-col">

  <!-- Main Content Wrapper -->
  <main class="flex flex-grow overflow-hidden">
    <!-- Sidebar -->
    <div class="w-1/6 bg-white text-white h-full overflow-y-auto">
      <%= render 'layouts/admin/sidebar' %>
    </div>

    <!-- Main Content -->
    <div class="w-5/6 bg-tertiary h-full overflow-y-auto p-4 mr-6 mt-2">
      <!-- Header -->
      <header>
        <%= render 'layouts/admin/header' %>
      </header>

      <% if user_signed_in? %>
        <p>Welcome, <%= current_user.email %></p>
        <%= link_to 'Dashboard', admin_root_path %> |
        <%= link_to "Sign out", destroy_user_session_path, :method => :delete %>
      <% else %>
        <%= link_to 'Login', new_user_session_path %> |
        <%= link_to 'Sign Up', new_user_registration_path %>
      <% end %>

      <%= yield %>
      <%= render 'layouts/admin/toast_container' %>
    </div>
  </main>
</body>
</html>
