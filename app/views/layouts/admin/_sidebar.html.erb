<div class="flex flex-col h-full w-full bg-gray-500 text-black">
  <!-- Logo Section -->
  <div class="logo mt-5 mb-8">
    <div class="flex gap-2 items-center justify-center">
      <%= image_tag('https://techzaa.in/larkon/admin/assets/images/logo-sm.png', class: "w-6") %>
      <h2 class="text-white font-bold text-3xl mb-0">Larkon</h2>
    </div>
  </div>

  <!-- General Text Section -->
  <div class="ml-4"> 
    <p class="text-gray-400 text-xs font-semibold">General</p>
  </div>
  <!-- Navigation Menu -->
  <nav class="flex flex-col mt-2">
    <%= link_to admin_root_path, class: "flex items-center text-gray-400 text-sm px-4 py-3 #{active_class('admin/dashboard')} hover:bg-gray-700" do %>
      <%= image_tag("icons/dashboard.svg", class: "w-5 h-5 #{active_class('admin/dashboard') ? 'filter-primary' : 'filter-gray'}") %>
      <span class="ml-2">Dashboard</span>
    <% end %>

    <!-- Collapsible Category Menu -->
    <%= render "layouts/admin/menu/category_menu" %>

    <%# Collapsible Brand Menu  %>
    <%= render "layouts/admin/menu/brand_menu" %>

    <!-- Product Link -->
    <%= link_to admin_posts_path, class: "flex items-center text-gray-400 text-sm px-4 py-3 hover:bg-gray-700" do %>
      <%= image_tag("icons/product.svg", class: "w-5 h-5 #{active_class('admin/products') ? 'filter-primary' : 'filter-gray'}") %>
      <span class="ml-2">Product</span>
    <% end %>

  </nav>
</div>
