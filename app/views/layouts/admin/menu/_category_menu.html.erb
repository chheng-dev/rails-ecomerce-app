<div class="relative group">
  <%= link_to '#', class: "flex items-center justify-between text-gray-400 text-sm px-4 py-3 hover:bg-gray-700  #{active_class('admin/categories')}", id: "categoryDropdown", data: { toggle: "collapse" }, aria: { expanded: "false", controls: "categoryDropdownMenu" } do %>
    <div class="flex items-center">
      <%= image_tag("icons/category.svg", class: "w-5 h-5 #{active_class('admin/categories') ? 'filter-primary' : 'filter-gray'}", id: "categoryIcon") %>
      <span class="ml-2" id="categoryTitle">
        Category
      </span>
    </div>
    <%= image_tag('icons/arrow-down.svg',  class: "w-4 h-4 filter-gray", id: "dropdownIcon" )%>
  <% end %>

  <!-- Collapsible Submenu -->
  <div id="categoryDropdownMenu" class="hidden flex flex-col mt-2 pl-8">
    <%= link_to 'List', admin_categories_path, class: "block px-4 pb-2 text-sm #{request.path == admin_categories_path ? 'text-white' : 'text-gray-400'}" %>
    <%= link_to 'Create', new_admin_category_path, class: "block px-4 py-2 text-sm #{request.path == new_admin_category_path ? 'text-white' : 'text-gray-400'}" %>
  </div>
</div>
