<div class="relative group">
  <%= link_to '#', class: "flex items-center justify-between text-gray-400 text-sm px-4 py-3 hover:bg-gray-700 #{active_class('/admin/settings/option_types')}", 
                 id: "settingDropdown", 
                 aria: { expanded: "false", controls: "settingDropdownMenu" } do %>
    <div class="flex items-center">
      <%= image_tag("icons/setting.svg", 
                    class: "w-5 h-5 #{request.path.include?('/admin/settings/option_types') ? 'filter-primary' : 'filter-gray'}", 
                    id: "settingIcon") %>
      <span class="ml-2" id="settingTitle">
        Settings
      </span>
    </div>
    <%= image_tag('icons/arrow-down.svg', class: "w-4 h-4 filter-gray", id: "dropdownIcon") %>
  <% end %>

  <!-- Collapsible Submenu -->
  <div id="settingDropdownMenu" class="hidden flex flex-col mt-2 pl-8">
    <%= link_to 'Option Types',  admin_option_types_path, class: "block px-4 pb-2 text-sm #{request.path == admin_option_types_path ? 'text-white' : 'text-gray-400'}" %>
    <%# <%= link_to 'Option Values', admin_settings_option_type_option_values, class: "block px-4 py-2 text-sm #{request.path == admin_settings_option_type_option_values ? 'text-white' : 'text-gray-400'}" %> 
  </div>
</div>
