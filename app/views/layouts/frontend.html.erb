<!DOCTYPE html>
<html>
<head>
  <title>Frontend</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag 'frontend', media: 'all' %>
  <%= javascript_include_tag 'frontend' %>
  <%= javascript_pack_tag 'frontend', 'data-turbolinks-track': 'reload'  %>
</head>
<body>
  <header>
    <%= render 'layouts/frontend/navbar' %>
    <%= render 'layouts/frontend/menu_items' %>
  </header>
  <main>
    <%= yield %>
  </main>
  <footer>
    <p class="text-red-500">Frontend Footer</p>
  </footer>
</body>
</html>
